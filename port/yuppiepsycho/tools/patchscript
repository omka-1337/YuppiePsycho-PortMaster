#!/bin/bash
# First-launch setup for Yuppie Psycho, run by PortMaster's patcher UI
# (or directly by YuppiePsycho.sh on older PortMaster versions).
#
# Expects GAMEDIR, DATADIR and FRAMEWORK_DIR from the launcher.

GAMEDIR="${GAMEDIR:-$(cd "$(dirname "$0")/.." && pwd)}"
DATADIR="${DATADIR:-$GAMEDIR/gamedata}"
LOGFILE="$GAMEDIR/patchlog.txt"
exec > >(tee "$LOGFILE") 2>&1

echo "Yuppie Psycho first-time setup"
echo "------------------------------"

if [ -z "$(find "$DATADIR" -mindepth 1 -maxdepth 1 ! -name '.*' 2>/dev/null)" ]; then
  echo "No game files found in yuppiepsycho/gamedata."
  echo "Copy the complete game folder (Steam: Linux or Windows build) there."
  exit 1
fi

args=()
[ -n "$FRAMEWORK_DIR" ] && args+=(--framework-dir "$FRAMEWORK_DIR")
args+=(--native-arch "${YP_NATIVE_ARCH:-aarch64}")
args+=(--textures "${YP_TEXTURES:-full}")
IFS=: read -r -a native_dirs <<< "${YP_NATIVE_DIRS:-$GAMEDIR/libs.aarch64}"
for d in "${native_dirs[@]}"; do
  [ -n "$d" ] && args+=(--native-dir "$d")
done
python3 "$GAMEDIR/tools/ypport.py" prepare "$DATADIR" "${args[@]}"
status=$?

if [ $status -ne 0 ]; then
  echo
  echo "Setup failed (exit $status). A full report of the game files follows."
  python3 "$GAMEDIR/tools/ypport.py" inspect "$DATADIR" > "$GAMEDIR/inspect.txt" 2>&1
  cat "$GAMEDIR/inspect.txt"
  echo "Report saved to yuppiepsycho/inspect.txt"
  exit 1
fi

echo "Setup complete."
exit 0
